{
    "name": "ratoguras/laravel-migrate-backup",
    "description": "Automatically takes a database backup before running migrate:fresh or migrate:refresh",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Adish Dahal",
            "email": "me.adishdahal@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "RatoGuras\\LaravelMigrateBackup\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RatoGuras\\LaravelMigrateBackup\\LaravelMigrateBackupServiceProvider"
            ]
        }
    },
    "repositories": [
    {
        "type": "path",
        "url": "https://github.com/Packages-Rato-Guras/laravel-migrate-backup"
    }
],
    "minimum-stability": "dev",
    "prefer-stable": true
}